# Production .env template for the PMMS Division Edition deployment at
# http://pmms.app (this local Laragon machine — no new hosting this phase).
# Placeholders only — never commit a real .env with actual secrets.
# See docs/deployment.md for the full build/deploy procedure this file is
# one step of.

APP_NAME=PMMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pmms.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pmmsdb
DB_USERNAME=REPLACE_WITH_PRODUCTION_DB_USER
DB_PASSWORD=REPLACE_WITH_PRODUCTION_DB_PASSWORD

# database-backed session/cache/queue are appropriate at this single-server
# scale — no Redis needed for this deployment.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# WP-06-03 finding: unset/false by default, meaning session cookies would
# be sent over a non-HTTPS connection too. APP_URL above is https, so this
# MUST be true in production — see docs/deployment.md "Session cookie
# security."
SESSION_SECURE_COOKIE=true

# Owner decision 2026-07-26 (WP-06-07): polling-only in production, no
# Reverb server to supervise. `log` (not `null`) so a broadcast attempt is
# visible in storage/logs during initial go-live verification; every live
# score is still fully readable via the 5-second poll regardless of this
# value — see docs/live-scoring.md. If real-time push is wanted later,
# see docs/deployment.md "Changing the broadcast decision" before
# reintroducing REVERB_* vars here.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# REQUIRED before go-live — Fortify's email verification (required for
# every self-registered account) and password-reset flow both need real
# outgoing mail; MAIL_MAILER=log (the framework/dev default) only writes
# to a log file and silently blocks both flows for real users. No SMTP
# provider was available as of this WP (2026-07-26) — replace every value
# below once one is arranged. See docs/deployment.md "Outgoing email —
# required before go-live."
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS="noreply@pmms.app"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Required in production — config/pmms.php has no local fallback outside
# local/testing environments. Set a real, strong password before the
# first `php artisan db:seed` (AdminUserSeeder) run against this database.
PMMS_ADMIN_NAME="PMMS Administrator"
PMMS_ADMIN_EMAIL=admin@pmms.local
PMMS_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
